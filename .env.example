# Get a free key at https://the-odds-api.com (needed for DraftKings, BetMGM, Caesars, Fanatics and Bally Bet)
ODDS_API_KEY=

# Optional: extra hostnames the private server answers to, comma-separated (e.g. this Mac's Tailscale name).
# PRIVATE_HOSTS=my-mac.your-tailnet.ts.net

# Contact sent to Apple/Google push services with each alert (mailto: or https: URL).
# PUSH_CONTACT=mailto:you@example.com

# Optional: lets the private History page invite people to the public site (invites.py).
# Token permission: "Access: Groups" (Read and Edit).
# CF_API_TOKEN=
# CF_ACCOUNT_ID=
# CF_ACCESS_GROUP_ID=
